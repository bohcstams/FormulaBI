<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>job_load_dump</name>
  <description>Backfills stg.jolpica_laps and stg.jolpica_pitstops from the Jolpica CSV database dump.</description>
  <extended_description/>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/10/27 21:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/10/27 21:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>DUMP_URL</name>
      <default_value>https://api.jolpi.ca/data/dumps/download/delayed/?dump_type=csv</default_value>
      <description>Free (14 days delayed) CSV dump of the Jolpica database</description>
    </parameter>
  </parameters>
  <connection>
    <name>FormulaBIDatabase</name>
    <server>localhost</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>formulabi</database>
    <port>5432</port>
    <username>formulabi</username>
    <password>Encrypted 2be98afc86aa7f282a40ba365d293add3</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>EXTRA_OPTION_POSTGRESQL.stringtype</code><attribute>unspecified</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>5432</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <slaveservers>
  </slaveservers>
  <pass_batchid>N</pass_batchid>
  <shared_objects_file/>
  <entries>
    <entry>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>64</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Create dump folder</name>
      <description/>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <foldername>${Internal.Entry.Current.Directory}/../data/jolpica_dump</foldername>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>160</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Download dump</name>
      <description/>
      <type>HTTP</type>
      <attributes/>
      <url>${DUMP_URL}</url>
      <targetfilename>${Internal.Entry.Current.Directory}/../data/jolpica_dump/jolpica-f1-csv.zip</targetfilename>
      <file_appended>N</file_appended>
      <date_time_added>N</date_time_added>
      <targetfilename_extension/>
      <uploadfilename/>
      <run_every_row>N</run_every_row>
      <ignore_ssl>N</ignore_ssl>
      <url_fieldname/>
      <upload_fieldname/>
      <dest_fieldname/>
      <username/>
      <password>Encrypted </password>
      <proxy_host/>
      <proxy_port/>
      <non_proxy_hosts/>
      <addfilenameresult>N</addfilenameresult>
      <headers>
      </headers>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>256</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Unzip dump</name>
      <description/>
      <type>UNZIP</type>
      <attributes/>
      <zipfilename>${Internal.Entry.Current.Directory}/../data/jolpica_dump/jolpica-f1-csv.zip</zipfilename>
      <wildcard>.*\.csv</wildcard>
      <wildcardexclude/>
      <targetdirectory>${Internal.Entry.Current.Directory}/../data/jolpica_dump</targetdirectory>
      <movetodirectory/>
      <afterunzip>0</afterunzip>
      <addfiletoresult>N</addfiletoresult>
      <isfromprevious>N</isfromprevious>
      <adddate>N</adddate>
      <addtime>N</addtime>
      <addOriginalTimestamp>N</addOriginalTimestamp>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <rootzip>N</rootzip>
      <createfolder>Y</createfolder>
      <nr_limit>10</nr_limit>
      <wildcardSource/>
      <success_condition>success_if_no_errors</success_condition>
      <create_move_to_directory>N</create_move_to_directory>
      <setOriginalModificationDate>N</setOriginalModificationDate>
      <iffileexists>overwrite</iffileexists>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>352</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Create dump tables (SQL)</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${Internal.Entry.Current.Directory}/../db/init/02_dump_schema.sql</sqlfilename>
      <sendOneStatement>T</sendOneStatement>
      <connection>FormulaBIDatabase</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>448</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Load dump CSV files</name>
      <description/>
      <type>TRANS</type>
      <attributes/>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/tr_load_dump_csv.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <cluster>N</cluster>
      <slave_server_name/>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <logging_remote_work>N</logging_remote_work>
      <run_configuration>Pentaho local</run_configuration>
      <suppress_result_data>N</suppress_result_data>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>DUMP_DIR</name>
          <stream_name/>
          <value>${Internal.Entry.Current.Directory}/../data/jolpica_dump</value>
        </parameter>
      </parameters>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>544</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Build laps and pit stops (SQL)</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${Internal.Entry.Current.Directory}/../db/transform/stg_from_dump.sql</sqlfilename>
      <sendOneStatement>T</sendOneStatement>
      <connection>FormulaBIDatabase</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>640</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>112</xloc>
      <yloc>736</yloc>
      <attributes_kjc/>
    </entry>
  </entries>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create dump folder</to>
      <from_nr>0</from_nr>
      <to_nr>0</to_nr>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
